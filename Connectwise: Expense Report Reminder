    {
      "parameters": {
        "jsCode": "// Group expense reports by member\nconst reports = $input.all();\nconst now = new Date();\n\n// ============================================\n// CONFIGURE YOUR EMAIL DOMAIN HERE\n// ============================================\nconst EMAIL_DOMAIN = '@yourcompany.com';\n\n// Group by member\nconst byMember = {};\n\nfor (const report of reports) {\n  const r = report.json;\n  const memberId = r.member?.identifier || 'Unknown';\n  const memberName = r.member?.name || 'Unknown';\n  const memberEmail = r.member?.identifier ? `${r.member.identifier}${EMAIL_DOMAIN}` : null;\n  \n  if (!byMember[memberId]) {\n    byMember[memberId] = {\n      memberId,\n      memberName,\n      memberEmail,\n      reports: [],\n      totalAmount: 0,\n      oldestReportDate: null\n    };\n  }\n  \n  // Calculate age in days from dateEnd\n  const reportEndDate = new Date(r.dateEnd);\n  const ageDays = Math.floor((now - reportEndDate) / (1000 * 60 * 60 * 24));\n  \n  byMember[memberId].reports.push({\n    id: r.id,\n    period: r.period,\n    year: r.year,\n    dateStart: r.dateStart,\n    dateEnd: r.dateEnd,\n    dueDate: r.dueDate,\n    ageDays,\n    total: r.total || 0\n  });\n  \n  byMember[memberId].totalAmount += (r.total || 0);\n  \n  // Track oldest report\n  if (!byMember[memberId].oldestReportDate || reportEndDate < new Date(byMember[memberId].oldestReportDate)) {\n    byMember[memberId].oldestReportDate = r.dateEnd;\n  }\n}\n\n// Convert to array and add summary\nreturn Object.values(byMember).map(member => {\n  const oldestDate = new Date(member.oldestReportDate);\n  const oldestAgeDays = Math.floor((now - oldestDate) / (1000 * 60 * 60 * 24));\n  \n  return {\n    json: {\n      ...member,\n      reportCount: member.reports.length,\n      oldestAgeDays\n    }\n  };\n});"
      },
      "id": "f8e58bdc-7448-450b-8e68-9fb9cf872273",
      "name": "Group by Member",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [32, -216]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop-each-member",
      "name": "Loop Each Member",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [256, -216]
    },
    {
      "parameters": {
        "jsCode": "// Format the email body for each member\nconst member = $input.item.json;\n\n// Build expense report table rows\nlet tableRows = member.reports\n  .sort((a, b) => new Date(a.dateStart) - new Date(b.dateStart))\n  .map(r => {\n    const startFormatted = new Date(r.dateStart).toLocaleDateString('en-US', {\n      month: 'short',\n      day: 'numeric'\n    });\n    const endFormatted = new Date(r.dateEnd).toLocaleDateString('en-US', {\n      month: 'short',\n      day: 'numeric',\n      year: 'numeric'\n    });\n    const dueFormatted = new Date(r.dueDate).toLocaleDateString('en-US', {\n      month: 'short',\n      day: 'numeric'\n    });\n    const ageWarning = r.ageDays > 7 ? ' ⚠️' : '';\n    const overdue = new Date(r.dueDate) < new Date() ? ' <span style=\"color: #dc3545;\">(OVERDUE)</span>' : '';\n    \n    return `<tr>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">${startFormatted} - ${endFormatted}${ageWarning}</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">$${r.total.toFixed(2)}</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">${dueFormatted}${overdue}</td>\n    </tr>`;\n  })\n  .join('');\n\nconst urgencyNote = member.oldestAgeDays > 14 \n  ? `<p style=\"color: #dc3545; font-weight: bold;\">⚠️ You have expense reports that are ${member.oldestAgeDays} days overdue. Please submit as soon as possible.</p>`\n  : member.oldestAgeDays > 7\n  ? `<p style=\"color: #ffc107; font-weight: bold;\">⚠️ You have expense reports that are ${member.oldestAgeDays} days old.</p>`\n  : '';\n\nconst emailBody = `\n<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n  <h2 style=\"color: #333;\">Expense Report Reminder</h2>\n  \n  <p>Hi ${member.memberName.split(' ')[0]},</p>\n  \n  <p>You have <strong>${member.reportCount} unsubmitted expense report${member.reportCount > 1 ? 's' : ''}</strong> totaling <strong>$${member.totalAmount.toFixed(2)}</strong> that need to be submitted.</p>\n  \n  ${urgencyNote}\n  \n  <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n    <thead>\n      <tr style=\"background-color: #f8f9fa;\">\n        <th style=\"padding: 10px; text-align: left; border-bottom: 2px solid #dee2e6;\">Period</th>\n        <th style=\"padding: 10px; text-align: left; border-bottom: 2px solid #dee2e6;\">Amount</th>\n        <th style=\"padding: 10px; text-align: left; border-bottom: 2px solid #dee2e6;\">Due Date</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${tableRows}\n    </tbody>\n    <tfoot>\n      <tr style=\"background-color: #f8f9fa; font-weight: bold;\">\n        <td style=\"padding: 10px;\">Total</td>\n        <td style=\"padding: 10px;\">$${member.totalAmount.toFixed(2)}</td>\n        <td style=\"padding: 10px;\"></td>\n      </tr>\n    </tfoot>\n  </table>\n  \n  <p><strong>How to submit:</strong></p>\n  <ol>\n    <li>Log into ConnectWise</li>\n    <li>Go to <strong>Time & Expense → My Expense Reports</strong></li>\n    <li>Click on the report period, review your expenses</li>\n    <li>Click <strong>Submit</strong></li>\n  </ol>\n  \n  <p style=\"color: #666; font-size: 12px; margin-top: 30px;\">This is an automated reminder.</p>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    ...member,\n    emailSubject: `Expense Reminder: ${member.reportCount} unsubmitted report${member.reportCount > 1 ? 's' : ''} ($${member.totalAmount.toFixed(2)})`,\n    emailBody\n  }\n}];"
      },
