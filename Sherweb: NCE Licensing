        "jsCode": "// Format Ticket Note After License Reduction Scheduled\n// Version: v4 - Concise format for single-ticket-per-company\n\nconst data = $('Capture Ticket ID').item.json;\nconst ticketId = data.ticketId;\nconst amendmentResponse = $('Schedule License Reduction').first().json;\nconst verifyResponse = $('Verify Subscription Changes').all().map(i => i.json);\n\nif (!data || !data.hasOptimizationOpportunity) {\n  return [{ json: { ...data, reductionNote: null, hasReductionNote: false, ticketId } }];\n}\n\n// Build verification lookup\nconst verifiedSubs = {};\nfor (const sub of verifyResponse) {\n  if (sub.items && Array.isArray(sub.items)) {\n    for (const item of sub.items) {\n      if (item.id) verifiedSubs[item.id] = item;\n    }\n  } else if (sub.id) {\n    verifiedSubs[sub.id] = sub;\n  }\n}\n\nconst today = new Date().toISOString().split('T')[0];\nlet note = `REDUCTION SCHEDULED - ${today}\\n`;\n\nlet totalReduced = 0;\nlet verifiedCount = 0;\nlet failedCount = 0;\nconst lines = [];\n\nfor (const opp of data.optimizationOpportunities) {\n  const verified = verifiedSubs[opp.cspSubscriptionId];\n  const scheduledQty = verified?.scheduledQuantity || verified?.quantity;\n  const isVerified = scheduledQty !== undefined && scheduledQty <= opp.newQuantity;\n  \n  if (isVerified) verifiedCount++;\n  else failedCount++;\n  \n  const status = isVerified ? 'OK' : '??';\n  const commit = opp.commitmentType === 'Monthly' ? 'M' : opp.commitmentType === 'Annual' ? 'A' : '?';\n  const effectiveDate = opp.renewalDate ? opp.renewalDate.split('T')[0] : 'TBD';\n  \n  lines.push(`[${status}][${commit}] ${opp.licenseName}: ${opp.currentQuantity}->${opp.newQuantity} (-${opp.reductionAmount}) eff ${effectiveDate}`);\n  totalReduced += opp.reductionAmount;\n}\n\nnote += lines.join('\\n');\nnote += `\\n\\nTotal: -${totalReduced} licenses | Verified: ${verifiedCount}/${lines.length}`;\n\nif (failedCount > 0) {\n  note += ` | CHECK SHERWEB`;\n}\n\nif (amendmentResponse?.subscriptionsAmendmentId) {\n  note += `\\nAmendment: ${amendmentResponse.subscriptionsAmendmentId}`;\n}\n\nreturn [{ json: { ...data, reductionNote: note, hasReductionNote: true, totalLicensesReduced: totalReduced, verifiedCount, failedCount, ticketId } }];"
