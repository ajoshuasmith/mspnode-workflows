      "parameters": {
        "jsCode": "// Analyze CIPP licenses for both upsell (60 days) and optimization (post-renewal)\n// Version: v7.1 - Fixed commitment type handling + date validation for requiredDate field\n// Input: Licenses from CIPP, Company data from v5 sub-workflow\n// Output: Analysis with ALL licenses (with status indicators) + specific opportunities\n// Includes: Enterprise E3 security upsell, 300-user Business limit check\n// NCE Rules:\n//   - Monthly: Can reduce starting CIPP day 0 (day before Sherweb renewal) through day -7\n//   - Annual: Can only reduce starting CIPP day -1 (Sherweb renewal date) through day -7\n// Note: CIPP's day 0 = termEndDate, Sherweb renewal = termEndDate + 1 day\n\n// =============================================================================\n// MSP CONFIGURATION - CUSTOMIZE THESE VALUES FOR YOUR ORGANIZATION\n// =============================================================================\n// Update these settings to match your MSP's standard license offerings and\n// messaging preferences. These values control how the workflow identifies\n// opportunities and what recommendations it makes.\n\nconst MSP_CONFIG = {\n  // Your MSP's standard/recommended license SKUs (used to identify non-standard licenses)\n  standardLicenses: [\n    'Microsoft 365 Business Premium',\n    'Microsoft 365 E3',\n    'Microsoft 365 E5'\n  ],\n  \n  // Licenses you typically recommend upgrading TO\n  recommendedUpgrades: {\n    'business basic': 'Microsoft 365 Business Premium',\n    'business standard': 'Microsoft 365 Business Premium',\n    'office 365 e1': 'Microsoft 365 E3',\n    'office 365 e3': 'Microsoft 365 E3'\n  },\n  \n  // Custom messages for ticket notes (customize for your branding)\n  messages: {\n    upgradeRecommendation: 'Consider upgrading to your standard license package',\n    unusedLicenses: 'Review unused licenses with customer before renewal',\n    e3Security: 'Recommend E5 Security add-on for enhanced Defender and Entra ID P2',\n    businessLimit: 'Approaching 300-user Business limit - plan Enterprise migration',\n    nonStandardLicense: 'Non-standard license detected - verify if this meets customer needs'\n  },\n  \n  // Workflow timing settings\n  upsellWindowDays: 60,           // Days before renewal to flag for customer contact\n  businessUserWarningThreshold: 250,  // Warn when Business users exceed this count\n  businessUserLimit: 300              // Hard limit for Business SKUs\n};\n\n// =============================================================================\n// END MSP CONFIGURATION - Do not modify below unless you know what you're doing\n// =============================================================================\n\nconst licenses = $input.all().map(i => i.json);\nconst customer = $('Loop Over Items').item.json;\n\nconst today = new Date();\nconst UPSELL_WINDOW_DAYS = MSP_CONFIG.upsellWindowDays;\nconst OPTIMIZATION_WINDOW_START_MONTHLY = 0;  // CIPP day 0 = day before Sherweb renewal (can reduce early)\nconst OPTIMIZATION_WINDOW_START_ANNUAL = -1;  // CIPP day -1 = Sherweb renewal date (unlocks here)\nconst OPTIMIZATION_WINDOW_END = -7;           // 7 days after renewal (NCE cancellation window)\nconst BUSINESS_USER_LIMIT = MSP_CONFIG.businessUserLimit;\nconst BUSINESS_USER_WARNING_THRESHOLD = MSP_CONFIG.businessUserWarningThreshold; // Warn when approaching limit\n\n// Track ALL licenses with status indicators\nconst allLicenses = [];\n\n// Track specific opportunities (for automation)\nconst upsellOpportunities = [];\nconst optimizationOpportunities = [];\n\n// Track license type totals for limit checks\nlet totalBusinessPremiumUsers = 0;\nlet totalE3Users = 0;\nlet hasE5Security = false;\nlet e5SecurityCount = 0;\n\n// Helper: Check if license is a candidate for Premium upgrade (Business Basic/Standard)\nconst isUpgradeCandidate = (licenseName) => {\n  const name = licenseName.toLowerCase();\n  return name.includes('business basic') || name.includes('business standard');\n};\n\n// Helper: Check if license is Business Premium\nconst isBusinessPremium = (licenseName) => {\n  const name = licenseName.toLowerCase();\n  return name.includes('business premium') || name.includes('spb');\n};\n\n// Helper: Check if license becomes redundant with Premium\nconst isRedundantWithPremium = (licenseName) => {\n  const name = licenseName.toLowerCase();\n  // Defender Plan 1 is included in Business Premium\n  return name.includes('defender for office 365') && name.includes('plan 1');\n};\n\n// Helper: Check if license is Microsoft 365 E3\nconst isEnterpriseE3 = (licenseName) => {\n  const name = licenseName.toLowerCase();\n  return (name.includes('microsoft 365 e3') ||\n          name.includes('office 365 e3') ||\n          name.includes('enterprisepack'));\n};\n\n// Helper: Check if license is E5 Security add-on\nconst isE5Security = (licenseName) => {\n  const name = licenseName.toLowerCase();\n  return (name.includes('e5 security') ||\n          name.includes('identity_threat_protection') ||\n          name.includes('microsoft 365 e5 security'));\n};\n\nfor (const license of licenses) {\n  const totalLicenses = parseInt(license.TotalLicenses) || 0;\n  const usedLicenses = parseInt(license.CountUsed) || 0;\n  const unusedCount = totalLicenses - usedLicenses;\n  const licenseName = license.License || license.skuPartNumber;\n\n  // Track totals for limit checks (regardless of term info)\n  if (isBusinessPremium(licenseName)) {\n    totalBusinessPremiumUsers += usedLicenses;\n  }\n  if (isEnterpriseE3(licenseName)) {\n    totalE3Users += usedLicenses;\n  }\n  if (isE5Security(licenseName)) {\n    hasE5Security = true;\n    e5SecurityCount += usedLicenses;\n  }\n\n  // Get term info for status determination\n  const termInfo = license.TermInfo;\n  const daysUntilRenewal = termInfo?.DaysUntilRenew;\n  const term = termInfo?.Term || '';\n  const isTrial = termInfo?.IsTrial || false;\n  const status = termInfo?.Status || 'Unknown';\n\n  // Determine license status/window\n  let windowStatus = 'outside';\n  let statusNote = '';\n  let isValidNCE = false;\n\n  if (!termInfo) {\n    statusNote = 'No term info';\n  } else if (isTrial) {\n    statusNote = 'Trial license';\n  } else if (term.toLowerCase().includes('unknown') || term.toLowerCase().includes('non-nce')) {\n    statusNote = 'Non-NCE license';\n  } else if (daysUntilRenewal == null) {\n    statusNote = 'No renewal date';\n  } else if (daysUntilRenewal < OPTIMIZATION_WINDOW_END) {\n    statusNote = status === 'Suspended' ? 'Suspended' : 'Past cancellation window';\n  } else {\n    isValidNCE = true;\n\n    // Check commitment type: Monthly = month-to-month (flexible), Yearly = annual commitment (locked)\n    const isMonthlyCommitment = term.toLowerCase().includes('monthly');\n    const isAnnualCommitment = term.toLowerCase().includes('yearly') || term.toLowerCase().includes('annual');\n\n    if (isMonthlyCommitment) {\n      // Monthly commitment: Reduce day before Sherweb renewal (CIPP day 0) through day -7\n      if (daysUntilRenewal <= OPTIMIZATION_WINDOW_START_MONTHLY && daysUntilRenewal >= OPTIMIZATION_WINDOW_END) {\n        windowStatus = 'optimization';\n        statusNote = 'Monthly commitment - in reduction window';\n      } else if (daysUntilRenewal <= UPSELL_WINDOW_DAYS && daysUntilRenewal > OPTIMIZATION_WINDOW_START_MONTHLY) {\n        windowStatus = 'upsell';\n        statusNote = 'Monthly renewal coming - review licenses';\n      } else if (daysUntilRenewal > UPSELL_WINDOW_DAYS) {\n        statusNote = `Renews in ${daysUntilRenewal} days`;\n      } else {\n        statusNote = 'Past reduction window';\n      }\n    } else if (isAnnualCommitment) {\n      // Annual commitment: Window starts at Sherweb renewal date (CIPP day -1) through day -7\n      if (daysUntilRenewal <= OPTIMIZATION_WINDOW_START_ANNUAL && daysUntilRenewal >= OPTIMIZATION_WINDOW_END) {\n        windowStatus = 'optimization';\n        statusNote = 'In NCE cancellation window (can reduce)';\n      } else if (daysUntilRenewal <= UPSELL_WINDOW_DAYS && daysUntilRenewal > OPTIMIZATION_WINDOW_START_ANNUAL) {\n        windowStatus = 'upsell';\n        statusNote = 'Renewing soon - contact customer';\n      } else if (daysUntilRenewal > UPSELL_WINDOW_DAYS) {\n        statusNote = `Renews in ${daysUntilRenewal} days`;\n      } else {\n        statusNote = 'Past cancellation window';\n      }\n    } else {\n      // Unknown commitment type - treat conservatively as annual\n      if (daysUntilRenewal <= OPTIMIZATION_WINDOW_START_ANNUAL && daysUntilRenewal >= OPTIMIZATION_WINDOW_END) {\n        windowStatus = 'optimization';\n        statusNote = 'In NCE cancellation window (can reduce)';\n      } else if (daysUntilRenewal <= UPSELL_WINDOW_DAYS && daysUntilRenewal > OPTIMIZATION_WINDOW_START_ANNUAL) {\n        windowStatus = 'upsell';\n        statusNote = 'Renewing soon - contact customer';\n      } else {\n        statusNote = `Renews in ${daysUntilRenewal} days`;\n      }\n    }\n  }\n\n  const isPremium = isBusinessPremium(licenseName);\n  const canUpgrade = isUpgradeCandidate(licenseName);\n  const redundantWithPremium = isRedundantWithPremium(licenseName);\n  const isE3 = isEnterpriseE3(licenseName);\n\n  // Determine commitment type for display\n  const commitmentType = term.toLowerCase().includes('monthly') ? 'Monthly' :\n                         (term.toLowerCase().includes('yearly') || term.toLowerCase().includes('annual')) ? 'Annual' : 'Unknown';\n\n  // Build license record for ALL licenses display\n  const licenseRecord = {\n    licenseName: licenseName,\n    skuId: license.skuId,\n    currentQuantity: totalLicenses,\n    usedCount: usedLicenses,\n    unusedCount: unusedCount,\n    status: status,\n    windowStatus: windowStatus,\n    statusNote: statusNote,\n    isValidNCE: isValidNCE,\n    isTrial: isTrial,\n    isBusinessPremium: isPremium,\n    canUpgradeToPremium: canUpgrade,\n    redundantWithPremium: redundantWithPremium,\n    isEnterpriseE3: isE3,\n    renewalDate: termInfo?.NextLifecycle || null,\n    daysUntilRenewal: daysUntilRenewal,\n    term: term,\n    commitmentType: commitmentType,\n    subscriptionId: termInfo?.SubscriptionId,\n    cspSubscriptionId: termInfo?.CSPSubscriptionId\n  };\n\n  allLicenses.push(licenseRecord);\n\n  // Only add to specific opportunity arrays if valid NCE\n  if (!isValidNCE) continue;\n\n  // UPSELL OPPORTUNITY (60 days out, down to Sherweb renewal date)\n  // For Annual: Contact before renewal to discuss needs\n  // For Monthly: Still relevant to discuss upcoming renewal, but less urgent\n  const isInUpsellWindow = daysUntilRenewal <= UPSELL_WINDOW_DAYS && daysUntilRenewal > OPTIMIZATION_WINDOW_START_ANNUAL;\n  if (isInUpsellWindow) {\n    upsellOpportunities.push({\n      ...licenseRecord,\n      needsE5Security: isE3 && !hasE5Security\n    });\n  }\n\n  // OPTIMIZATION OPPORTUNITY\n  // Monthly commitment: Reduce day before Sherweb renewal (CIPP day 0) through day -7\n  // Annual commitment: Reduce on Sherweb renewal date (CIPP day -1) through day -7\n  const isMonthlyTerm = term.toLowerCase().includes('monthly');\n  const canOptimizeMonthly = isMonthlyTerm && daysUntilRenewal <= OPTIMIZATION_WINDOW_START_MONTHLY && daysUntilRenewal >= OPTIMIZATION_WINDOW_END && unusedCount > 0 && totalLicenses > 1;\n  const canOptimizeAnnual = !isMonthlyTerm && daysUntilRenewal <= OPTIMIZATION_WINDOW_START_ANNUAL && daysUntilRenewal >= OPTIMIZATION_WINDOW_END && unusedCount > 0 && totalLicenses > 1;\n\n  if (canOptimizeMonthly || canOptimizeAnnual) {\n    const newQuantity = Math.max(1, usedLicenses);\n\n    optimizationOpportunities.push({\n      ...licenseRecord,\n      newQuantity: newQuantity,\n      reductionAmount: totalLicenses - newQuantity\n    });\n  }\n}\n\n// Calculate totals and summaries\nconst hasUpsellOpportunity = upsellOpportunities.length > 0;\nconst hasOptimizationOpportunity = optimizationOpportunities.length > 0;\nconst totalReduction = optimizationOpportunities.reduce((sum, a) => sum + a.reductionAmount, 0);\n\n// Count Business upgrade opportunities\nconst basicStandardCount = upsellOpportunities.filter(o => o.canUpgradeToPremium).length;\nconst defenderPlan1Count = upsellOpportunities.filter(o => o.redundantWithPremium).length;\nconst premiumCount = upsellOpportunities.filter(o => o.isBusinessPremium).length;\n\n// Count Enterprise E3 security opportunities\nconst e3Count = upsellOpportunities.filter(o => o.isEnterpriseE3).length;\nconst e3NeedsSecurityCount = upsellOpportunities.filter(o => o.needsE5Security).length;\nconst e3UsersWithoutSecurity = totalE3Users - e5SecurityCount;\n\n// Count upsell opportunities with unused licenses (potential reduction at renewal)\nconst upsellWithUnusedCount = upsellOpportunities.filter(o => o.unusedCount > 0).length;\n\n// Determine if upsell is actionable (something to discuss with customer)\n// Actionable if: can upgrade, has redundant licenses, needs E3 security, or has unused licenses\nconst hasActionableUpsell = basicStandardCount > 0 ||\n                            defenderPlan1Count > 0 ||\n                            e3NeedsSecurityCount > 0 ||\n                            upsellWithUnusedCount > 0;\n\n// Business 300-user limit check\nconst isApproachingBusinessLimit = totalBusinessPremiumUsers >= BUSINESS_USER_WARNING_THRESHOLD;\nconst hasExceededBusinessLimit = totalBusinessPremiumUsers >= BUSINESS_USER_LIMIT;\nconst businessLimitWarning = isApproachingBusinessLimit\n  ? hasExceededBusinessLimit\n    ? `CRITICAL: ${totalBusinessPremiumUsers} Business Premium users - exceeds 300-user limit! Migration to Enterprise required.`\n    : `WARNING: ${totalBusinessPremiumUsers} Business Premium users - approaching 300-user limit. Plan migration to Enterprise.`\n  : null;\n\n// Determine if any ticket is needed\n// Create ticket for any upsell opportunity (for logging), but auto-close if not actionable\nconst needsTicket = hasUpsellOpportunity || hasOptimizationOpportunity;\n\n// Get earliest renewal date for ticket summary\nlet earliestRenewalDate = null;\nconst allOpportunities = [...upsellOpportunities, ...optimizationOpportunities];\nif (allOpportunities.length > 0) {\n  // Filter out null/invalid renewal dates\n  const validDates = allOpportunities\n    .filter(o => o.renewalDate)\n    .map(o => new Date(o.renewalDate))\n    .filter(d => !isNaN(d.getTime()));\n\n  if (validDates.length > 0) {\n    earliestRenewalDate = new Date(Math.min(...validDates));\n  }\n}\n\nconst formatDate = (date) => {\n  if (!date || isNaN(date.getTime())) return null;\n  const year = date.getFullYear();\n  const month = String(date.getMonth() + 1).padStart(2, '0');\n  const day = String(date.getDate()).padStart(2, '0');\n  return `${year}-${month}-${day}`;\n};\n\n// Use today's date as fallback if no valid renewal date found\nconst renewalDateStr = formatDate(earliestRenewalDate) || formatDate(new Date());\n\n// Build ticket summary based on what opportunities exist\nlet ticketSummary = '';\nif (isApproachingBusinessLimit) {\n  ticketSummary = `Microsoft 365 License Limit Warning - ${customer.companyName}`;\n} else if (hasUpsellOpportunity && hasOptimizationOpportunity) {\n  ticketSummary = `Microsoft NCE License Review - ${renewalDateStr}`;\n} else if (hasUpsellOpportunity) {\n  ticketSummary = `Microsoft NCE License Renewal - ${renewalDateStr}`;\n} else if (hasOptimizationOpportunity) {\n  ticketSummary = `Microsoft NCE License Optimization - ${renewalDateStr}`;\n} else if (e3UsersWithoutSecurity > 0) {\n  ticketSummary = `Microsoft E3 Security Review - ${customer.companyName}`;\n}\n\n// Determine if ticket is needed (includes new triggers)\nconst hasE3SecurityOpportunity = e3NeedsSecurityCount > 0 || e3UsersWithoutSecurity > 0;\nconst hasBusinessLimitWarning = isApproachingBusinessLimit;\nconst needsTicketFinal = needsTicket || hasE3SecurityOpportunity || hasBusinessLimitWarning;\n\n// Determine if ticket should auto-close after creation\n// Auto-close if: no actionable upsell AND no E3 security gap AND no business limit warning\nconst shouldAutoClose = !hasActionableUpsell && !hasE3SecurityOpportunity && !hasBusinessLimitWarning;\n\nreturn [{\n  json: {\n    // Company info from v5 sub-workflow\n    customerName: customer.companyName,\n    domainName: customer.domainName,\n    cwCompanyId: customer.cwCompanyId,\n    huduCompanyId: customer.huduCompanyId,\n    sherwebId: customer.identifiers?.sherwebId,\n    microsoftTenantId: customer.identifiers?.microsoftTenantId,\n\n    // Combined opportunity flags\n    needsTicket: needsTicketFinal,\n    hasAnyOpportunity: needsTicketFinal,\n\n    // ALL licenses with status indicators (for ticket display)\n    allLicenses,\n    totalLicenseCount: allLicenses.length,\n\n    // Upsell opportunity data (60-day window)\n    hasUpsellOpportunity,\n    upsellCount: upsellOpportunities.length,\n    upsellOpportunities,\n\n    // Business upgrade breakdown\n    basicStandardCount,      // Can upgrade to Premium\n    defenderPlan1Count,      // Redundant if they get Premium\n    premiumCount,            // Already on Premium\n    upsellWithUnusedCount,   // Upsell licenses with unused seats\n    hasActionableUpsell,     // Is there something to discuss?\n\n    // Enterprise E3 security opportunity\n    hasE3SecurityOpportunity,\n    e3Count,                 // E3 licenses renewing\n    e3NeedsSecurityCount,    // E3 renewing without E5 Security\n    totalE3Users,            // Total E3 users\n    hasE5Security,           // Has any E5 Security licenses\n    e5SecurityCount,         // Number of E5 Security licenses\n    e3UsersWithoutSecurity,  // E3 users missing security add-on\n\n    // Business 300-user limit\n    hasBusinessLimitWarning,\n    isApproachingBusinessLimit,\n    hasExceededBusinessLimit,\n    totalBusinessPremiumUsers,\n    businessLimitWarning,\n\n    // Optimization opportunity data (post-renewal window)\n    hasOptimizationOpportunity,\n    optimizationCount: optimizationOpportunities.length,\n    totalReduction,\n    optimizationOpportunities,\n\n    // Ticket info\n    ticketSummary,\n    earliestRenewalDate: renewalDateStr,\n    shouldAutoClose,          // Auto-close if nothing actionable\n\n    message: needsTicketFinal\n      ? 'Opportunities found'\n      : 'No opportunities within renewal windows'\n  }\n}];\n"
      },
