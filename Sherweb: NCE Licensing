      "parameters": {
        "jsCode": "// Format Combined Ticket for NCE License Review\n// Version: v6 - Added shouldAutoClose support for \"nothing to do\" tickets\n// Input: Analysis data from Analyze Licenses, Pricing data from Sherweb\n// Output: ticketTitle, ticketBody for ConnectWise ticket\n\nconst data = $('Analyze Licenses').item.json;\nconst pricingResponse = $('Get customer subscription pricing').all().map(i => i.json);\n\nif (!data) {\n  throw new Error('Missing license analysis data');\n}\n\n// Sherweb returns { items: [...] } - flatten to get all pricing items\nconst pricingItems = [];\nfor (const response of pricingResponse) {\n  if (response.items && Array.isArray(response.items)) {\n    pricingItems.push(...response.items);\n  }\n}\n\n// Build pricing lookup by subscription ID\nconst pricingBySubscription = {};\nfor (const price of pricingItems) {\n  if (price.id) {\n    pricingBySubscription[price.id] = price;\n  }\n}\n\n// Helper to get price for a subscription\nconst getPrice = (cspSubscriptionId) => {\n  const pricing = pricingBySubscription[cspSubscriptionId];\n  if (pricing && pricing.fees && pricing.fees.recurringFee !== undefined) {\n    return parseFloat(pricing.fees.recurringFee) || 0;\n  }\n  return null;\n};\n\n// Helper to format currency\nconst formatCurrency = (amount) => {\n  if (amount === null || amount === undefined) return '';\n  return `$${amount.toFixed(2)}`;\n};\n\n// Helper to format date safely\nconst formatDate = (dateStr) => {\n  if (!dateStr) return 'Unknown';\n  return dateStr.split('T')[0];\n};\n\n// Build ticket title\nconst ticketTitle = data.ticketSummary;\n\n// Build ticket body - CONDENSED FORMAT\nlet body = '';\n\n// Header\nbody += `Microsoft NCE License Review - ${data.customerName}\\n`;\nbody += `${'='.repeat(50)}\\n`;\nbody += `Domain: ${data.domainName}\\n`;\nif (data.earliestRenewalDate) {\n  body += `Renewal: ${data.earliestRenewalDate}\\n`;\n}\nbody += `\\n`;\n\n// ACTION REQUIRED section (most important - at top)\nbody += `ACTION REQUIRED\\n`;\nbody += `${'-'.repeat(20)}\\n`;\n\nif (data.hasBusinessLimitWarning) {\n  if (data.hasExceededBusinessLimit) {\n    body += `> [CRITICAL] ${data.totalBusinessPremiumUsers} Business Premium users - exceeds 300 limit\\n`;\n    body += `> Schedule migration to Enterprise immediately\\n`;\n  } else {\n    body += `> [WARNING] ${data.totalBusinessPremiumUsers}/300 Business Premium users\\n`;\n    body += `> Plan migration to Enterprise before limit reached\\n`;\n  }\n}\n\nif (data.hasUpsellOpportunity && data.hasActionableUpsell) {\n  body += `> Contact customer about ${data.upsellCount} license(s) renewing soon\\n`;\n  if (data.basicStandardCount > 0) {\n    body += `> ${data.basicStandardCount} upgrade candidate(s) (Basic/Standard -> Premium)\\n`;\n  }\n  if (data.upsellWithUnusedCount > 0) {\n    body += `> ${data.upsellWithUnusedCount} license(s) with unused seats to review\\n`;\n  }\n}\n\nif (data.hasOptimizationOpportunity) {\n  body += `> ${data.totalReduction} unused license(s) will auto-reduce\\n`;\n}\n\nif (data.hasE3SecurityOpportunity && data.e3UsersWithoutSecurity > 0) {\n  body += `> ${data.e3UsersWithoutSecurity} E3 user(s) without E5 Security\\n`;\n}\n\n// If nothing actionable, indicate this is for logging only\nif (data.shouldAutoClose) {\n  body += `> [AUTO-CLOSED] No action required - logged for audit purposes\\n`;\n}\n\nbody += `\\n`;\n\n// Group licenses by window status\nconst upsellLicenses = data.allLicenses.filter(l => l.windowStatus === 'upsell');\nconst optimizationLicenses = data.allLicenses.filter(l => l.windowStatus === 'optimization');\nconst outsideLicenses = data.allLicenses.filter(l => l.windowStatus === 'outside');\n\n// RENEWING SOON section\nif (upsellLicenses.length > 0) {\n  body += `RENEWING SOON (1-60 days)\\n`;\n  body += `${'-'.repeat(25)}\\n`;\n\n  for (const lic of upsellLicenses) {\n    const unitPrice = getPrice(lic.cspSubscriptionId);\n    const commitmentBadge = lic.commitmentType === 'Monthly' ? '[MONTHLY]' : lic.commitmentType === 'Annual' ? '[ANNUAL]' : '';\n    let line = `${commitmentBadge} ${lic.licenseName}`;\n    if (lic.canUpgradeToPremium) line += ` [UPGRADE]`;\n    if (lic.redundantWithPremium) line += ` [REDUNDANT]`;\n    body += `${line}\\n`;\n\n    let details = `  Commitment: ${lic.commitmentType || 'Unknown'}`;\n    details += ` | ${lic.usedCount}/${lic.currentQuantity} used`;\n    details += ` | Renews: ${formatDate(lic.renewalDate)}`;\n    if (unitPrice !== null) details += ` | ${formatCurrency(unitPrice)}/mo`;\n    if (lic.unusedCount > 0) details += ` | ${lic.unusedCount} unused`;\n    body += `${details}\\n`;\n  }\n  body += `\\n`;\n}\n\n// AUTO-REDUCING section\nif (optimizationLicenses.length > 0) {\n  body += `AUTO-REDUCING (in cancellation window)\\n`;\n  body += `${'-'.repeat(35)}\\n`;\n\n  let totalSavings = 0;\n  for (const lic of optimizationLicenses) {\n    const unitPrice = getPrice(lic.cspSubscriptionId);\n    const savings = unitPrice !== null ? unitPrice * (lic.currentQuantity - lic.usedCount) : null;\n    if (savings) totalSavings += savings;\n\n    const commitmentBadge = lic.commitmentType === 'Monthly' ? '[MONTHLY]' : lic.commitmentType === 'Annual' ? '[ANNUAL]' : '';\n    body += `${commitmentBadge} ${lic.licenseName}\\n`;\n    let details = `  Commitment: ${lic.commitmentType || 'Unknown'}`;\n    details += ` | ${lic.currentQuantity} -> ${lic.usedCount} seats`;\n    if (savings) details += ` | Saves: ${formatCurrency(savings)}/mo`;\n    body += `${details}\\n`;\n  }\n\n  if (totalSavings > 0) {\n    body += `\\nTotal Savings: ${formatCurrency(totalSavings)}/mo (${formatCurrency(totalSavings * 12)}/yr)\\n`;\n  }\n  body += `\\n`;\n}\n\n// OTHER LICENSES section (condensed)\nif (outsideLicenses.length > 0) {\n  body += `OTHER LICENSES\\n`;\n  body += `${'-'.repeat(15)}\\n`;\n\n  for (const lic of outsideLicenses) {\n    const commitmentShort = lic.commitmentType === 'Monthly' ? 'M' : lic.commitmentType === 'Annual' ? 'A' : '?';\n    let line = `[${commitmentShort}] ${lic.licenseName}: ${lic.usedCount}/${lic.currentQuantity}`;\n    if (lic.renewalDate && lic.daysUntilRenewal > 0) {\n      line += ` | ${formatDate(lic.renewalDate)}`;\n    } else {\n      line += ` | ${lic.statusNote}`;\n    }\n    body += `${line}\\n`;\n  }\n  body += `\\n`;\n}\n\n// Footer with legend\nbody += `---\\n`;\nbody += `COMMITMENT TYPES:\\n`;\nbody += `[ANNUAL] = Annual commitment (1-year lock, can only reduce in 7-day window after renewal)\\n`;\nbody += `[MONTHLY] = Month-to-month (flexible, can reduce day before through 7 days after renewal)\\n`;\nbody += `[A] = Annual | [M] = Monthly\\n\\n`;\nbody += `Auto-generated by NCE License Review workflow`;\n\nreturn [{\n  json: {\n    ...data,\n    ticketTitle,\n    ticketBody: body\n  }\n}];"
      },
